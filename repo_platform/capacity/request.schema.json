    {
      "type": "object",
      "properties": {
        "action": {
          "const": "succeed_pressure_control"
        },
        "expected_source": {
          "$ref": "#/$defs/ExpectedSource"
        },
        "expected_policy_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expected_scheduling_revision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 18446744073709551615
        },
        "expected_reservations": {
          "oneOf": [
            {
              "$ref": "#/$defs/GPUReservationConfiguration"
            },
            {
              "type": "null"
            }
          ],
          "description": "Complete observed selection. Supply null when the host has none."
        },
        "system_id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S",
          "not": {
            "pattern": "\\u0000"
          }
        },
        "previous_control": {
          "$ref": "#/$defs/DomainControl",
          "description": "Exact currently enrolled callback, including any router arguments."
        },
        "control": {
          "$ref": "#/$defs/DomainControl",
          "not": {
            "properties": {
              "argv": {
                "minItems": 2,
                "prefixItems": [
                  true,
                  {
                    "const": "route-pressure-control"
                  }
                ]
              }
            }
          },
          "description": "Changed, qualified callback for future requests. Pending callbacks keep their original timing."
        },
        "change_ref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 4096,
          "pattern": "\\S",
          "not": {
            "pattern": "\\u0000"
          }
        }
      },
