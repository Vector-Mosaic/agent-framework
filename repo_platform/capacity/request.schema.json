            "overview",
            "inspect",
            "follow",
            "evidence",
            "controls",
            "control",
            "diagnostic"
          ]
        },
        "host_id": {
          "type": "string",
          "minLength": 1
        },
        "allocation_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "timeout_ms": {
          "type": "integer",
          "minimum": 0,
          "maximum": 30000
        },
        "parameters": {
          "type": "object",
          "description": "Read selectors below. operation=controls returns each available control with its exact input_schema for parameters (source/revision, not direct expected_source fields). diagnostic accepts only action=cpu_policy|io_policy. Follow reuses cursor and view without page position.",
          "properties": {
            "view": {
              "enum": [
                "current",
                "history",
                "allocation",
                "policy",
                "holds",
                "pressure",
                "gpu_pressure",
                "maintenance"
