{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Apeiros Linux capacity operation",
  "type": "object",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "action": {
          "const": "inspect"
        },
        "view": {
          "enum": [
            "current",
            "history",
            "allocation",
            "policy",
            "holds",
            "pressure",
            "gpu_pressure",
            "maintenance"
          ],
          "description": "Focused selection. allocation requires exact allocation_id; page returned source/after_id without changing the selection."
        },
        "allocation_id": {
          "type": "string",
          "minLength": 1
        },
        "source": {
          "type": "object",
          "properties": {
            "instance_id": {
              "type": "string",
              "minLength": 1
            },
            "host_id": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "instance_id",
            "host_id"
          ],
          "additionalProperties": false
        },
        "after_id": {
          "type": "string",
          "minLength": 1
        },
        "limit": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100,
          "default": 25
        }
      },
      "required": [
        "action"
      ],
      "additionalProperties": false,
      "description": "Without view: existing full-state machine snapshot including retained history/counters. For routine use choose overview or an explicit focused view.",
      "dependentRequired": {
        "allocation_id": [
          "view"
        ],
        "source": [
          "view"
        ],
        "after_id": [
          "view"
        ],
        "limit": [
          "view"
        ]
      }
    },
    {
      "type": "object",
      "properties": {
        "action": {
