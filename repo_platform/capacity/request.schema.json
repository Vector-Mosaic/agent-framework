        "scheduling_revision": {
          "type": "integer",
          "minimum": 0,
          "description": "Exact current scheduling policy revision, required after an effective scheduling policy is installed."
        }
      },
      "required": [
        "action",
        "revision"
      ],
      "additionalProperties": false
    },
