{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Tool Result v1",
  "type": "object",
  "required": [
    "schema_version",
    "tool_id",
    "status",
    "verb",
    "summary",
    "data",
    "warnings",
    "errors"
  ],
  "properties": {
    "schema_version": {
      "const": "tool_result.v1"
    },
    "tool_id": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "enum": ["ok", "warn", "error"]
    },
    "verb": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "data": {
      "type": "object"
    },
    "warnings": {
      "type": "array"
    },
    "errors": {
      "type": "array"
    }
  },
  "additionalProperties": true
}
