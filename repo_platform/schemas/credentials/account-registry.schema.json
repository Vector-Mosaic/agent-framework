{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Private Agent Framework account registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "version",
    "namespace",
    "accounts"
  ],
  "properties": {
    "version": {
      "const": 1
    },
    "namespace": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
    },
    "secret_service_collection": {
      "type": "string",
      "pattern": "^/org/freedesktop/secrets/(collection|aliases)/[A-Za-z0-9_/]+$"
    },
    "accounts": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "status",
          "allowed_origins",
          "credentials"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_.-]{0,127}$"
          },
          "status": {
            "enum": [
              "active",
              "disabled",
              "recovery_required"
            ]
          },
          "allowed_origins": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "type": "string",
              "pattern": "^https://[^/?#]+$"
            }
          },
          "identity": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "mailbox": {
                "type": "string",
                "minLength": 1
              },
              "username": {
                "type": "string",
                "minLength": 1
              }
            }
          },
          "credentials": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "password": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "security_answer": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              },
              "totp": {
                "type": "string",
                "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$"
              }
            }
          },
          "federated": {
            "type": "boolean"
          },
          "security_answer_bound": {
            "type": "boolean"
          }
        }
      }
    }
  },
  "description": "Metadata only. Runtime additionally enforces canonical exact HTTPS origins, unique account IDs and credential references, federation and purpose bindings. Never store secret values here."
}
